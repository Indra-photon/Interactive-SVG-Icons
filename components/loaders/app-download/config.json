{
  "name": "App Download",
  "category": "loaders",
  "tags": [
    "apple",
    "download",
    "arc",
    "progress",
    "stroke",
    "appstore"
  ],
  "description": "A single circular arc draws itself from 12 o'clock clockwise, then resets \u2014 like the App Store download ring",
  "createdAt": "2026-05-14",
  "variations": [
    {
      "name": "default",
      "displayName": "App Download",
      "tier": "free",
      "description": "A rounded arc sweeps around a faint track using strokeDashoffset animation, with a brief pause between each full rotation",
      "animationType": "loop",
      "dependencies": [
        "framer-motion"
      ],
      "props": [
        {
          "name": "width",
          "type": "number",
          "default": 100,
          "description": "Width of the loader in pixels"
        },
        {
          "name": "height",
          "type": "number",
          "default": 100,
          "description": "Height of the loader in pixels"
        },
        {
          "name": "color",
          "type": "string",
          "default": "currentColor",
          "description": "Stroke color of the arc"
        },
        {
          "name": "trackOpacity",
          "type": "number",
          "default": 0.12,
          "description": "Opacity of the background track circle"
        },
        {
          "name": "isAnimating",
          "type": "boolean",
          "default": true,
          "description": "Controls whether the animation runs"
        },
        {
          "name": "duration",
          "type": "number",
          "default": 1.5,
          "description": "Animation cycle duration in seconds",
          "min": 0.1,
          "max": 8,
          "step": 0.1
        },
        {
          "name": "ease",
          "type": "ease",
          "default": "easeInOut",
          "description": "Easing function"
        },
        {
          "name": "strokeWidth",
          "type": "number",
          "default": 5,
          "description": "Stroke width of the arc",
          "min": 1,
          "max": 12,
          "step": 0.5
        },
        {
          "name": "strokeLinecap",
          "type": "enum",
          "default": "round",
          "options": [
            "round",
            "butt",
            "square"
          ],
          "description": "Stroke line cap style"
        },
        {
          "name": "repeatDelay",
          "type": "number",
          "default": 0.4,
          "description": "Pause between cycles in seconds",
          "min": 0,
          "max": 5,
          "step": 0.1
        }
      ],
      "componentName": "AppDownload"
    }
  ]
}