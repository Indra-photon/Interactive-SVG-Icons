{
  "name": "Infinity Loop",
  "category": "loaders",
  "tags": [
    "infinity",
    "loop",
    "smooth",
    "continuous",
    "path",
    "minimal",
    "symbol",
    "elegant"
  ],
  "description": "A dot travels continuously along an infinity symbol path in an elegant figure-eight motion",
  "createdAt": "2026-02-26",
  "variations": [
    {
      "name": "default",
      "displayName": "Infinity Loop",
      "tier": "free",
      "description": "A dot traces the mathematical lemniscate (infinity symbol) path smoothly and continuously",
      "animationType": "loop",
      "dependencies": [
        "framer-motion"
      ],
      "props": [
        {
          "name": "width",
          "type": "number",
          "default": 80,
          "description": "Width of the loader container in pixels"
        },
        {
          "name": "height",
          "type": "number",
          "default": 40,
          "description": "Height of the loader container in pixels"
        },
        {
          "name": "color",
          "type": "string",
          "default": "currentColor",
          "description": "Color of the traveling dot"
        },
        {
          "name": "pathColor",
          "type": "string",
          "default": "#cccccc",
          "description": "Color of the infinity path outline"
        },
        {
          "name": "dotSize",
          "type": "number",
          "default": 6,
          "description": "Diameter of the traveling dot in pixels"
        },
        {
          "name": "showPath",
          "type": "boolean",
          "default": true,
          "description": "Whether to show the infinity symbol path outline"
        },
        {
          "name": "isAnimating",
          "type": "boolean",
          "default": true,
          "description": "Controls whether the animation runs. Set to false to pause animation."
        },
        {
          "name": "duration",
          "type": "number",
          "default": 2.5,
          "description": "Animation cycle duration in seconds",
          "min": 0.1,
          "max": 8,
          "step": 0.1
        },
        {
          "name": "ease",
          "type": "ease",
          "default": "linear",
          "description": "Easing function"
        },
        {
          "name": "strokeWidth",
          "type": "number",
          "default": 2,
          "description": "Stroke width of the path",
          "min": 1,
          "max": 8,
          "step": 0.5
        },
        {
          "name": "strokeLinecap",
          "type": "enum",
          "default": "round",
          "options": [
            "round",
            "butt",
            "square"
          ],
          "description": "Stroke line cap style"
        }
      ],
      "componentName": "InfinityLoop"
    }
  ]
}