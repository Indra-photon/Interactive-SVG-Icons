          "type": "boolean",
          "default": false,
          "description": "Controls the light. Set to true to turn the lamp on."
        },
        {
          "name": "duration",
          "type": "number",
          "default": 0.4,
          "required": false,
          "description": "Duration of the light on/off fade in seconds",
          "min": 0.1,
          "max": 3,
          "step": 0.05
        },
        {
          "name": "ease",
          "type": "ease",
          "default": "easeOut",
          "required": false,
