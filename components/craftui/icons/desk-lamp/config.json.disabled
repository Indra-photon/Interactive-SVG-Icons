        },
        {
          "name": "accentColor",
          "type": "string",
          "default": "#e8836f",
          "description": "Accent color for the hinge pins and base button"
        },
        {
          "name": "glowColor",
          "type": "string",
          "default": "#f7c877",
          "description": "Warm color of the lit interior and halo"
