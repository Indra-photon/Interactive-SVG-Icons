          "max": 8,
          "step": 0.1
        },
        {
          "name": "ease",
          "type": "ease",
          "default": "easeInOut",
          "description": "Easing function"
        },
        {
          "name": "staggerDelay",
          "type": "number",
          "default": 0.2,
          "description": "Delay offset per element in seconds",
          "min": 0,
          "max": 0.5,
          "step": 0.01
