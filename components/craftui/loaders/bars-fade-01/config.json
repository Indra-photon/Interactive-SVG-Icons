{
  "name": "Bars Fade",
  "category": "loaders",
  "tags": [
    "bars",
    "loading",
    "fade",
    "vertical",
    "opacity"
  ],
  "description": "Three vertical bars fading in and out sequentially",
  "createdAt": "2026-02-20",
  "variations": [
